      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Engine</string>
          <string name="Source"><![CDATA[local Rules = if script then require(game:GetService("ReplicatedStorage").Shared.Rules)
    else require("../shared/Rules")
local Engine = {}
Engine.__index = Engine

function Engine.new(seats, randomInteger)
    assert(#seats >= 3 and #seats <= 6, "Wizard needs 3–6 seats")
    local self = setmetatable({}, Engine)
    self.seats, self.randomInteger = {}, randomInteger
    self.round, self.dealer, self.revision = 0, #seats, 0
    self.maxRounds, self.history = math.floor(60 / #seats), {}
    for _, seat in ipairs(seats) do
        table.insert(self.seats, { id = seat.id, name = seat.name, bot = seat.bot == true,
            score = 0, taken = 0, hand = {} })
    end
    self:nextRound()
    return self
end

function Engine:nextSeat(seat) return seat % #self.seats + 1 end

function Engine:nextRound()
    assert(self.round == 0 or self.phase == "roundComplete", "Round is not complete")
    self.round += 1
    self.dealer = self:nextSeat(self.dealer)
    self.leader = self:nextSeat(self.dealer)
    self.turn, self.trick, self.trickNumber, self.lastWinner = self.leader, {}, 1, nil
    self.trump, self.turnedCard = nil, nil
    local deck = Rules.shuffle(Rules.deck(), self.randomInteger)
    local cursor = 1
    for _, seat in ipairs(self.seats) do seat.hand, seat.bid, seat.taken, seat.delta = {}, nil, 0, nil end
    for _ = 1, self.round do
        for offset = 1, #self.seats do
            local seat = self.seats[(self.dealer + offset - 1) % #self.seats + 1]
            table.insert(seat.hand, deck[cursor])
            cursor += 1
        end
    end
    self.turnedCard = deck[cursor]
    if self.turnedCard and self.turnedCard.kind == "wizard" then
        self.phase, self.turn = "chooseTrump", self.dealer
    else
        if self.turnedCard and self.turnedCard.kind == "number" then self.trump = self.turnedCard.suit end
        self.phase = "bidding"
    end
    self.revision += 1
end

function Engine:act(seatIndex, action, value)
    if seatIndex ~= self.turn then return false, "Du bist noch nicht am Zug." end
    local seat = self.seats[seatIndex]
    if self.phase == "chooseTrump" and action == "trump" then
        if type(value) ~= "string" or not table.find(Rules.suits, value) then
            return false, "Wähle eine der vier Farben."
        end
        self.trump, self.phase, self.turn = value, "bidding", self.leader
    elseif self.phase == "bidding" and action == "bid" then
        if not Rules.integer(value, 0, self.round) then return false, "Ungültige Stichansage." end
        seat.bid = value
        self.turn = self:nextSeat(self.turn)
        if self.turn == self.leader then self.phase = "playing" end
    elseif self.phase == "playing" and action == "play" then
        if type(value) ~= "string" or #value > 24 then return false, "Ungültige Karte." end
        local index
        for i, card in ipairs(seat.hand) do if card.id == value then index = i; break end end
        if not index then return false, "Diese Karte hast du nicht auf der Hand." end
        if not Rules.canPlay(seat.hand, seat.hand[index], self.trick) then
            return false, "Du musst die angespielte Farbe bedienen."
        end
        table.insert(self.trick, { seat = seatIndex, card = table.remove(seat.hand, index) })
        self.turn = self:nextSeat(self.turn)
        if #self.trick == #self.seats then
            self.lastWinner = Rules.winner(self.trick, self.trump)
            self.seats[self.lastWinner].taken += 1
            self.phase, self.turn = "trickComplete", nil
        end
    else
        return false, "Diese Aktion ist gerade nicht möglich."
    end
    self.revision += 1
    return true
end

function Engine:advance()
    if self.phase == "trickComplete" then
        if self.trickNumber == self.round then
            local results = {}
            for i, seat in ipairs(self.seats) do
                seat.delta = Rules.score(seat.bid, seat.taken)
                seat.score += seat.delta
                results[i] = { bid = seat.bid, taken = seat.taken, delta = seat.delta, score = seat.score }
            end
            table.insert(self.history, results)
            self.phase = if self.round == self.maxRounds then "finished" else "roundComplete"
        else
            self.trickNumber += 1
            self.trick, self.turn, self.phase = {}, self.lastWinner, "playing"
        end
        self.revision += 1
    elseif self.phase == "roundComplete" then self:nextRound()
    else return false end
    return true
end

function Engine:seatFor(id)
    for i, seat in ipairs(self.seats) do if seat.id == id then return i end end
    return nil
end

function Engine:view(id)
    local mine = self:seatFor(id)
    local view = { phase = self.phase, round = self.round, maxRounds = self.maxRounds,
        dealer = self.dealer, turn = self.turn, trump = self.trump, turnedCard = self.turnedCard,
        trickNumber = self.trickNumber, lastWinner = self.lastWinner, revision = self.revision,
        seats = {}, trick = {}, hand = {}, legal = {}, history = {}, mySeat = mine }
    for i, seat in ipairs(self.seats) do
        view.seats[i] = { id = seat.id, name = seat.name, bot = seat.bot, score = seat.score,
            bid = seat.bid, taken = seat.taken, count = #seat.hand, delta = seat.delta }
    end
    for i, play in ipairs(self.trick) do
        view.trick[i] = { seat = play.seat, card = table.clone(play.card) }
    end
    if self.turnedCard then view.turnedCard = table.clone(self.turnedCard) end
    if mine then
        for _, card in ipairs(self.seats[mine].hand) do
            table.insert(view.hand, table.clone(card))
            if self.phase == "playing" and self.turn == mine
                and Rules.canPlay(self.seats[mine].hand, card, self.trick) then view.legal[card.id] = true end
        end
    end
    for r, row in ipairs(self.history) do
        view.history[r] = {}
        for i, result in ipairs(row) do view.history[r][i] = table.clone(result) end
    end
    return view
end

-- Simple practice opponent: uses its own hand and public trick only.
function Engine:autoAction()
    local seat = self.seats[self.turn]
    if self.phase == "chooseTrump" then
        local best, weight = Rules.suits[1], -1
        for _, suit in ipairs(Rules.suits) do
            local total = 0
            for _, card in ipairs(seat.hand) do if card.suit == suit then total += card.rank end end
            if total > weight then best, weight = suit, total end
        end
        return "trump", best
    elseif self.phase == "bidding" then
        local estimate = 0
        for _, card in ipairs(seat.hand) do
            if card.kind == "wizard" then estimate += 1
            elseif card.kind == "number" then
                if card.suit == self.trump then estimate += 0.55 + card.rank / 40
                elseif card.rank >= 11 then estimate += 0.35 end
            end
        end
        return "bid", math.clamp(math.floor(estimate + 0.25), 0, self.round)
    elseif self.phase == "playing" then
        local choices = {}
        for _, card in ipairs(seat.hand) do
            if Rules.canPlay(seat.hand, card, self.trick) then table.insert(choices, card) end
        end
        local function strength(card)
            if card.kind == "wizard" then return 100 end
            if card.kind == "jester" then return 0 end
            return card.rank + (if card.suit == self.trump then 20 else 0)
        end
        table.sort(choices, function(a, b) return strength(a) < strength(b) end)
        if seat.taken < seat.bid then
            for _, card in ipairs(choices) do
                local trial = table.clone(self.trick)
                table.insert(trial, { seat = self.turn, card = card })
                if Rules.winner(trial, self.trump) == self.turn then return "play", card.id end
            end
        end
        return "play", choices[1].id
    end
    error("No automatic action available in " .. self.phase)
end

return Engine
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="6">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Engine = require(script.Parent.Engine)
local World = require(script.Parent.World)
World.build()
Players.CharacterAutoLoads = false

local remotes = Instance.new("Folder")
remotes.Name, remotes.Parent = "WizardRemotes", ReplicatedStorage
local action = Instance.new("RemoteEvent")
action.Name, action.Parent = "Action", remotes
local state = Instance.new("RemoteEvent")
state.Name, state.Parent = "State", remotes

local match, hostId, deadline
local order, buckets = {}, {}
local epoch = 0
local random = Random.new()
local TURN_SECONDS = 45

local function host()
    if hostId and Players:GetPlayerByUserId(hostId) then return hostId end
    hostId = nil
    -- Give control to a participant before considering spectators.
    if match then
        for _, seat in ipairs(match.seats) do
            if not seat.bot and Players:GetPlayerByUserId(seat.id) then hostId = seat.id; return hostId end
        end
    end
    for _, id in ipairs(order) do
        if Players:GetPlayerByUserId(id) then hostId = id; break end
    end
    return hostId
end

local function send(player)
    local view
    if match then view = match:view(player.UserId)
    else
        view = { phase = "lobby", seats = {}, revision = 0 }
        for _, id in ipairs(order) do
            local member = Players:GetPlayerByUserId(id)
            if member then table.insert(view.seats, { id = id, name = member.DisplayName }) end
        end
    end
    view.hostId, view.deadline, view.epoch = host(), deadline, epoch
    state:FireClient(player, view)
end

local function publish()
    for _, player in ipairs(Players:GetPlayers()) do send(player) end
end

local function schedule()
    if not match or match.phase == "finished" then deadline = nil; return end
    local duration
    if match.phase == "trickComplete" then duration = 2.5
    elseif match.phase == "roundComplete" then duration = 8
    elseif match.seats[match.turn].bot then duration = 1.2
    else duration = TURN_SECONDS end
    deadline = workspace:GetServerTimeNow() + duration
end

local function start(player, mode)
    if match then return end
    local seats = {}
    if mode == "practice" then
        -- Practice can be started by anyone and only seats the requester.
        table.insert(seats, { id = player.UserId, name = player.DisplayName })
        table.insert(seats, { id = -1, name = "Mira", bot = true })
        table.insert(seats, { id = -2, name = "Orion", bot = true })
    elseif mode == "friends" then
        if player.UserId ~= host() then return end
        for _, id in ipairs(order) do
            local member = Players:GetPlayerByUserId(id)
            if member and #seats < 6 then table.insert(seats, { id = id, name = member.DisplayName }) end
        end
        if #seats < 3 then
            state:FireClient(player, { error = "Für eine Mehrspielerpartie braucht ihr mindestens 3 Spieler." })
            return
        end
    else return end
    match = Engine.new(seats, function(a, b) return random:NextInteger(a, b) end)
    hostId, epoch = player.UserId, epoch + 1
    schedule()
    publish()
end

-- A token bucket limits all remote requests, including initial state requests.
local function allowed(player)
    local now = os.clock()
    local bucket = buckets[player.UserId] or { tokens = 12, time = now }
    bucket.tokens = math.min(12, bucket.tokens + (now - bucket.time) * 4)
    bucket.time = now
    buckets[player.UserId] = bucket
    if bucket.tokens < 1 then return false end
    bucket.tokens -= 1
    return true
end

action.OnServerEvent:Connect(function(player, verb, value, revision, clientEpoch)
    if not allowed(player) or type(verb) ~= "string" or #verb > 16 then return end
    if verb == "sync" then send(player); return end
    if verb == "start" then start(player, value); return end
    if verb == "lobby" then
        if match and match.phase == "finished" and player.UserId == host() then
            match, deadline = nil, nil
            epoch += 1
            publish()
        end
        return
    end
    if not match then return end
    if revision ~= match.revision or clientEpoch ~= epoch then send(player); return end
    local seatIndex = match:seatFor(player.UserId)
    if not seatIndex or match.seats[seatIndex].bot then return end
    local ok, message = match:act(seatIndex, verb, value)
    if ok then schedule(); publish()
    else state:FireClient(player, { error = message }) end
end)

local function joined(player)
    if not table.find(order, player.UserId) then table.insert(order, player.UserId) end
    publish()
end
Players.PlayerAdded:Connect(joined)
for _, player in ipairs(Players:GetPlayers()) do joined(player) end

Players.PlayerRemoving:Connect(function(player)
    local index = table.find(order, player.UserId)
    if index then table.remove(order, index) end
    buckets[player.UserId] = nil
    if hostId == player.UserId then hostId = nil end
    if match then
        local seatIndex = match:seatFor(player.UserId)
        if seatIndex then
            match.seats[seatIndex].bot = true
            match.seats[seatIndex].name ..= " (Bot)"
            match.revision += 1
            if match.turn == seatIndex then schedule() end
        end
        local humans = 0
        for _, seat in ipairs(match.seats) do if not seat.bot then humans += 1 end end
        if humans == 0 then match, deadline = nil, nil; epoch += 1 end
    end
    publish()
end)

task.spawn(function()
    while true do
        task.wait(0.2)
        if match and deadline and workspace:GetServerTimeNow() >= deadline then
            if match.phase == "trickComplete" or match.phase == "roundComplete" then match:advance()
            elseif match.turn then
                local verb, value = match:autoAction()
                match:act(match.turn, verb, value)
            end
            schedule()
            publish()
        end
    end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[local World = {}

function World.build()
    local Lighting = game:GetService("Lighting")
    Lighting.ClockTime = 0
    Lighting.Brightness = 1.5
    Lighting.Ambient = Color3.fromRGB(60, 49, 87)
    Lighting.OutdoorAmbient = Color3.fromRGB(24, 28, 50)
    Lighting.FogColor = Color3.fromRGB(14, 15, 30)
    Lighting.FogStart, Lighting.FogEnd = 40, 140
    local bloom = Instance.new("BloomEffect")
    bloom.Intensity, bloom.Size, bloom.Threshold = 0.4, 32, 1.2
    bloom.Parent = Lighting
    local model = Instance.new("Model")
    model.Name, model.Parent = "ArcaneHall", workspace

    local function part(name, size, position, color, material, shape)
        local object = Instance.new("Part")
        object.Name, object.Size, object.Position = name, size, position
        object.Color, object.Material = color, material or Enum.Material.Slate
        object.Anchored, object.CanCollide = true, false
        if shape then object.Shape = shape end
        object.Parent = model
        return object
    end
    local stone = Color3.fromRGB(32, 31, 48)
    local gold = Color3.fromRGB(170, 129, 67)
    part("Floor", Vector3.new(150, 1, 150), Vector3.new(0, -1, 0), stone)
    local tableBase = part("TableRim", Vector3.new(1, 26, 26), Vector3.new(0, 4, 0), gold, Enum.Material.Metal, Enum.PartType.Cylinder)
    tableBase.CFrame = CFrame.new(0, 4, 0) * CFrame.Angles(0, 0, math.pi / 2)
    local felt = part("Velvet", Vector3.new(0.25, 24.5, 24.5), Vector3.new(0, 4.7, 0), Color3.fromRGB(24, 58, 59), Enum.Material.Fabric, Enum.PartType.Cylinder)
    felt.CFrame = CFrame.new(0, 4.7, 0) * CFrame.Angles(0, 0, math.pi / 2)
    for i = 1, 12 do
        local angle = i * math.pi / 6
        local x, z = math.cos(angle) * 27, math.sin(angle) * 27
        part("Pillar", Vector3.new(3, 23, 3), Vector3.new(x, 10, z), stone, Enum.Material.Marble)
        part("Capital", Vector3.new(4.2, 0.8, 4.2), Vector3.new(x, 21.5, z), gold, Enum.Material.Metal)
        local orb = part("ArcaneLight", Vector3.new(1.7, 1.7, 1.7), Vector3.new(x * 0.8, 9, z * 0.8),
            Color3.fromRGB(148, 115, 255), Enum.Material.Neon, Enum.PartType.Ball)
        local light = Instance.new("PointLight")
        light.Color, light.Brightness, light.Range = orb.Color, 2, 20
        light.Parent = orb
    end
    for i = 1, 6 do
        local angle = (i - 1) * math.pi / 3
        local position = Vector3.new(math.cos(angle) * 16, 3, math.sin(angle) * 16)
        part("Chair", Vector3.new(4, 1, 4), position, Color3.fromRGB(69, 42, 84), Enum.Material.Fabric)
    end
end

return World
]]></string>
        </Properties>
      </Item>
